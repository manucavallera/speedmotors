DATABASE_URL=postgresql://user:password@localhost:5432/speedmotors
JWT_SECRET=cambiar_por_un_secreto_seguro
# Tiempo de vida del token JWT. Recomendado: 12h en producción (sin refresh tokens).
JWT_EXPIRES_IN=12h
PORT=3000

# Orígenes permitidos por CORS, separados por coma. Vacío = solo localhost:5173 (dev).
# Producción: setear al dominio público, ej: https://app.speedmotors.com.ar
ALLOWED_ORIGINS=

# Si "false", el backend NO corre migraciones al arrancar. Recomendado en producción
# para evitar despliegues rotos por migration falla. Correr `npm run db:migrate` manualmente.
AUTO_MIGRATE=true

# Notificaciones por email (opcional — si no se configura, el cron no envía nada)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_de_gmail
SMTP_FROM=SpeedMotors <tu_email@gmail.com>
ADMIN_EMAIL=destino@gmail.com
